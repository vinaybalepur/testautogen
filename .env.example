# Database
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_PORT=5432
DB_NAME=your_db_name
DATABASE_URL=postgresql://your_db_user:your_db_password@db:5432/your_db_name

# Server
PORT=5000
JWT_SECRET=generate_a_long_random_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NODE_ENV=production

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your_email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_TEST_PROJECT_KEY=YOUR_PROJECT_KEY

# Newman
NEWMAN_TIMEOUT_MS=60000
REPORT_RETENTION_DAYS=60

# API key encryption
ENCRYPTION_KEY=generate_a_32_character_key_here
